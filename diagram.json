{
  "version": 1,
  "author": "Harshini",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-v1",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {}
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "photo1",
      "top": -30,
      "left": 300,
      "attrs": {
        "lux": "400"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 120,
      "left": 220,
      "rotate": 90,
      "attrs": {
        "value": "220"
      }
    },
    {
      "type": "wokwi-led",
      "id": "led1",
      "top": 180,
      "left": 300,
      "attrs": {
        "color": "yellow"
      }
    }
  ],
  "connections": [
    ["esp:3V3", "photo1:VCC", "red", []],
    ["esp:GND.1", "photo1:GND", "black", []],
    ["esp:D34", "photo1:AO", "blue", []],

    ["esp:D18", "r1:1", "orange", []],
    ["r1:2", "led1:A", "orange", []],
    ["led1:C", "esp:GND.1", "black", []],

    ["esp:TX0", "$serialMonitor:RX", "", []],
    ["esp:RX0", "$serialMonitor:TX", "", []]
  ],
  "dependencies": {},
  "serialMonitor": {
    "display": "terminal",
    "convertEol": true
  }
}